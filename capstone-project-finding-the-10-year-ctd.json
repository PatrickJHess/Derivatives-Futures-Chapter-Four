_from_fedinvest.empty:\n    print(\"⚠️ WARNING: Eligible bonds missing from FedInvest:\")\n    display(missing_from_fedinvest)\nelse:\n    print(\"✅ All eligible bonds are in FedInvest.\")\n# ---------------------------------------------------------\n\n# 4. Final Inner Merge\ndf_combined = pd.merge(\n    clean_df_flat,\n    df_eligible_flat,\n    on=['Maturity', 'Coupon'],\n    how='inner'\n)\n\n# 5. Set index back and sort\ndf_combined = df_combined.set_index('Maturity').sort_values(by=['Maturity', 'Coupon'])","position":{"start":{"line":67,"column":1},"end":{"line":116,"column":1}},"key":"ca3p42Q4XQ"},{"type":"heading","depth":3,"position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"children":[],"key":"j0d2e335pU"},{"type":"heading","depth":3,"position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"children":[{"type":"strong","position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"children":[{"type":"text","value":"Clean up the Data","position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"key":"xykJ7S5T92"}],"key":"cvw3BOl1uK"}],"key":"ni6ujQLei3"}],"identifier":"clean-up-the-data","label":"Clean up the Data","html_id":"clean-up-the-data","implicit":true,"key":"meNjv6DjFj"},{"type":"code","lang":"py","value":"# copy used to make sure the DataFrames aren't linked\nnum_rows = clean_df.shape[0]\ndf_ctd = df_combined[:num_rows].copy()\n\n# vectorized calculation of clean prices\nbid_ask_true = (df_ctd['Price Bid'] > 0) & (df_ctd['Price Ask'] > 0)\n\n# bid/ask average assigned to true_value\ntrue_value = (df_ctd['Price Bid'] + df_ctd['Price Ask']) / 2\n\n# maximum of three prices assigned to false value\nfalse_value = df_ctd[['END OF DAY', 'Price Bid', 'Price Ask']].max(axis=1)\n\n# equivalent to a vectorized if-else assignment of clean price\ndf_ctd['Clean Price'] = np.where(bid_ask_true, true_value, false_value)","position":{"start":{"line":121,"column":1},"end":{"line":137,"column":1}},"key":"V3oTHCMVIQ"},{"type":"heading","depth":2,"position":{"start":{"line":139,"column":1},"end":{"line":139,"column":1}},"children":[{"type":"text","value":"---","position":{"start":{"line":139,"column":1},"end":{"line":139,"column":1}},"key":"trmz3Q2cwl"}],"identifier":"id","label":"---","html_id":"id","implicit":true,"key":"MjjSF7RkKK"},{"type":"heading","depth":2,"position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"children":[{"type":"strong","position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"children":[{"type":"text","value":"Step 2","position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"key":"AU2RFnsijA"}],"key":"oVUhbkdVxa"}],"key":"F1VBJ5z8Wl"}],"identifier":"step-2","label":"Step 2","html_id":"step-2","implicit":true,"key":"SiAcKqJ3LI"},{"type":"heading","depth":3,"position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"children":[{"type":"strong","position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"children":[{"type":"text","value":"Access SOFR","position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"key":"PUmELgpm3N"}],"key":"tlURYxsmOp"}],"key":"Au3rhGVLkb"}],"identifier":"access-sofr","label":"Access SOFR","html_id":"access-sofr","implicit":true,"key":"TvrtvLOa9D"},{"type":"code","lang":"py","value":"# Use FredReader to the SOFR Rate\nsofr_11_09=fred_data.get_series('SOFR',start_date=settlement,end_date=settlement)\n\n# Get the single value and convert it into floating decimal rate\nsofr=sofr_11_09.values[0]\nsofr_rate=float(sofr[0])\nsofr_rate=sofr_rate/100\n","position":{"start":{"line":145,"column":1},"end":{"line":154,"column":1}},"key":"Y8N9RvHZS4"},{"type":"heading","depth":3,"position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"children":[{"type":"strong","position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"children":[{"type":"text","value":"`timing_option`","position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"key":"EStjAgDxwg"}],"key":"AjB0lTs8tz"}],"key":"f2qZf2ZxjH"}],"identifier":"id-timing-option","label":"`timing_option`","html_id":"id-timing-option","implicit":true,"key":"syIGqN1D8p"},{"type":"code","lang":"py","value":"def timing_option(settlement, maturity, coupon, clean_price, sofr_rate, freq=2):\n   \"\"\"\n   Calculates accrued interest, dirty price, daily carry, and the optimal delivery\n   timing (Immediate vs Delay) for a Treasury bond.\n   \"\"\"\n   settlement = pd.Timestamp(settlement)\n   maturity = pd.Timestamp(maturity)\n   current_year = settlement.year\n\n   # --- HELPER FUNCTION ---\n   def get_proxy_maturity(mat, target_year):\n       \"\"\"Creates proxy maturity, utilizing Pandas' native month-end calendar logic.\"\"\"\n       if mat.is_month_end:\n           # Safely grab the exact last day of the target month (handles leap years natively)\n           last_day = pd.Timestamp(year=target_year, month=mat.month, day=1).days_in_month\n           return pd.Timestamp(year=target_year, month=mat.month, day=last_day)\n       else:\n           # Non-EOM dates (like the 15th) are immune to the Feb 29th ValueError\n           return mat.replace(year=target_year)\n   # -----------------------\n\n   # Optimize by creating a proxy maturity date just 1 year out\n   proxy_maturity = get_proxy_maturity(maturity, current_year + 1)\n\n   # 1. Find coupon dates (fq prefix for financial_quant)\n   dates = fq.scheduled_pay_dates(proxy_maturity, settlement=settlement, freq=freq)\n   next_date = pd.Timestamp(dates[0])\n\n   # Dynamically determine months between payments\n   months_between = int(12 / freq)\n\n   # 2. Handle end-of-month Treasury rule for the previous coupon\n   if next_date.is_month_end:\n       last_date = next_date - pd.offsets.MonthEnd(months_between)\n   else:\n       last_date = next_date - pd.DateOffset(months=months_between)\n\n   # 3. Calculate Actual/Actual day counts\n   days_between = (next_date - last_date).days\n   days_since = (settlement - last_date).days\n\n   # 4. Financial Calculations\n   coupon_payment = coupon / freq\n   accrued_interest = coupon_payment * (days_since / days_between)\n   daily_accrual = coupon_payment / days_between\n\n   dirty_price = clean_price + accrued_interest\n   daily_sofr_cost = dirty_price * (sofr_rate / 360)\n\n   return accrued_interest, dirty_price, daily_accrual, daily_sofr_cost, next_date\n","position":{"start":{"line":158,"column":1},"end":{"line":210,"column":1}},"key":"ygtdiZJZgv"},{"type":"heading","depth":3,"position":{"start":{"line":212,"column":1},"end":{"line":212,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":212,"column":1},"end":{"line":212,"column":1}},"children":[{"type":"strong","position":{"start":{"line":212,"column":1},"end":{"line":212,"column":1}},"children":[{"type":"text","value":"Calculate Values","position":{"start":{"line":212,"column":1},"end":{"line":212,"column":1}},"key":"FFqeuRPsrm"}],"key":"kQO4oJtsIC"}],"key":"HVf0MOaVC7"}],"identifier":"calculate-values","label":"Calculate Values","html_id":"calculate-values","implicit":true,"key":"kMTSUJUQIe"},{"type":"code","lang":"py","value":"df_ctd[['Accrued_Interest', 'Dirty Price', 'Daily_Accrual', 'Daily_Cost', 'Next_Coupon_Date']] = df_ctd.apply(\n    lambda row: timing_option(settlement,row.name,row['Coupon'],row['Clean Price'],sofr_rate),\n    axis=1,\n    result_type='expand'\n)\ndisplay(df_ctd.head(10))\n","position":{"start":{"line":214,"column":1},"end":{"line":222,"column":1}},"key":"gy7scH7t9C"},{"type":"heading","depth":3,"position":{"start":{"line":224,"column":1},"end":{"line":224,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":224,"column":1},"end":{"line":224,"column":1}},"children":[{"type":"strong","position":{"start":{"line":224,"column":1},"end":{"line":224,"column":1}},"children":[{"type":"text","value":"Get Settlement Price","position":{"start":{"line":224,"column":1},"end":{"line":224,"column":1}},"key":"RtUffNAPRn"}],"key":"PqWWHWZ6L9"}],"key":"yEnJfvLslJ"}],"identifier":"get-settlement-price","label":"Get Settlement Price","html_id":"get-settlement-price","implicit":true,"key":"WyQlzk81ag"},{"type":"code","lang":"py","value":"# Use MASSIVEReader\n# Query the December 2026 30-Year T-Bond futures (ZBZ6) on the transaction date\nstart='2026-11-09'\nfutures_11_09=massive_data.get_futures_data('ZBZ6',start_date=start,\n                                           end_date=start)\n\n# Extract the scalar settlement price from the single-row DataFrame\nsettlement_price=futures_11_09['settlement_price'].iloc[0]\nsettlement_price\n","position":{"start":{"line":226,"column":1},"end":{"line":237,"column":1}},"key":"a7SNhyyg80"},{"type":"heading","depth":3,"position":{"start":{"line":239,"column":1},"end":{"line":239,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":239,"column":1},"end":{"line":239,"column":1}},"children":[{"type":"strong","position":{"start":{"line":239,"column":1},"end":{"line":239,"column":1}},"children":[{"type":"text","value":"Accrued Interest Settlement Date","position":{"start":{"line":239,"column":1},"end":{"line":239,"column":1}},"key":"f7TkPiSFsh"}],"key":"qPNaokhBOb"}],"key":"hDmtz2DJmJ"}],"identifier":"accrued-interest-settlement-date","label":"Accrued Interest Settlement Date","html_id":"accrued-interest-settlement-date","implicit":true,"key":"TUPTMf8vs1"},{"type":"code","lang":"py","value":"# 1. Define Dates\nt_settlement = pd.Timestamp(settlement)\n\ndays_first = (first_delivery - t_settlement).days\ndays_last = (last_delivery - t_settlement).days\n\n# 2. Check for Interim Coupons and calculate Days Since Coupon\nhas_interim_first = df_ctd['Next_Coupon_Date'] <= first_delivery\nhas_interim_last = df_ctd['Next_Coupon_Date'] <= last_delivery\n\ndays_since_coupon_first = (first_delivery - df_ctd['Next_Coupon_Date']).dt.days\ndays_since_coupon_last = (last_delivery - df_ctd['Next_Coupon_Date']).dt.days\n\n# 3. Calculate Delivery Accrued (Resetting to 0 if an interim coupon was paid)\naccrued_first = np.where(\n    has_interim_first,\n    df_ctd['Daily_Accrual'] * days_since_coupon_first,\n    df_ctd['Accrued_Interest'] + (df_ctd['Daily_Accrual'] * days_first)\n)\n\naccrued_last = np.where(\n    has_interim_last,\n    df_ctd['Daily_Accrual'] * days_since_coupon_last,\n    df_ctd['Accrued_Interest'] + (df_ctd['Daily_Accrual'] * days_last)\n)\n\n# 4. Calculate Invoice Prices\ninvoice_base = settlement_price * df_ctd['Conversion_Factor']\ndf_ctd['Invoice_First'] = invoice_base + accrued_first\ndf_ctd['Invoice_Last'] = invoice_base + accrued_last\n\n# Display the Invoice Price results\n\n#  Drop raw price columns to declutter our working DataFrame\ndf_clean_ctd = df_ctd.drop(columns=['Price Bid', 'Price Ask', 'END OF DAY']).copy()\ndisplay(df_clean_ctd[['Clean Price', 'Next_Coupon_Date', 'Invoice_First', 'Invoice_Last']].head())\n","position":{"start":{"line":241,"column":1},"end":{"line":279,"column":1}},"key":"AsZReo10Le"},{"type":"thematicBreak","position":{"start":{"line":280,"column":1},"end":{"line":280,"column":1}},"key":"XAuhHdr0ZW"},{"type":"heading","depth":2,"position":{"start":{"line":282,"column":1},"end":{"line":282,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":282,"column":1},"end":{"line":282,"column":1}},"children":[{"type":"strong","position":{"start":{"line":282,"column":1},"end":{"line":282,"column":1}},"children":[{"type":"text","value":"Step 3","position":{"start":{"line":282,"column":1},"end":{"line":282,"column":1}},"key":"ySCaEYS5ty"}],"key":"SBTXZtRIFi"}],"key":"yafKJRCz4B"}],"identifier":"step-3","label":"Step 3","html_id":"step-3","implicit":true,"key":"bRDG5eDivj"},{"type":"heading","depth":3,"position":{"start":{"line":284,"column":1},"end":{"line":284,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":284,"column":1},"end":{"line":284,"column":1}},"children":[{"type":"strong","position":{"start":{"line":284,"column":1},"end":{"line":284,"column":1}},"children":[{"type":"text","value":"Forward Cash Prices","position":{"start":{"line":284,"column":1},"end":{"line":284,"column":1}},"key":"qqPnMHTEId"}],"key":"QbSdKyCKPA"}],"key":"nJTIfUJEJw"}],"identifier":"forward-cash-prices","label":"Forward Cash Prices","html_id":"forward-cash-prices","implicit":true,"key":"Mr6z0LU92L"},{"type":"code","lang":"py","value":"# 1. Calculate Spot Dirty Price (Clean Price + Spot Accrued Interest)\ndf_clean_ctd['Spot_Dirty'] = df_clean_ctd['Clean Price'] + df_clean_ctd['Accrued_Interest']\n\n# 2. Define the cash coupon payment (Semi-annual)\ncoupon_pmt = df_clean_ctd['Coupon'] / 2\n\n# 3. Calculate Forward Cash Prices\n# If an interim coupon is paid, we subtract the cash received from our total forward cost\ndf_clean_ctd['Forward_First'] = np.where(\n    has_interim_first,\n    df_clean_ctd['Spot_Dirty'] + (df_clean_ctd['Daily_Cost'] * days_first) - coupon_pmt,\n    df_clean_ctd['Spot_Dirty'] + (df_clean_ctd['Daily_Cost'] * days_first)\n)\n\ndf_clean_ctd['Forward_Last'] = np.where(\n    has_interim_last,\n    df_clean_ctd['Spot_Dirty'] + (df_clean_ctd['Daily_Cost'] * days_last) - coupon_pmt,\n    df_clean_ctd['Spot_Dirty'] + (df_clean_ctd['Daily_Cost'] * days_last)\n)\n\n# Display the Forward Prices\ndisplay(df_clean_ctd[['Clean Price', 'Spot_Dirty','Daily_Cost', 'Forward_First', 'Forward_Last']].head())\n","position":{"start":{"line":286,"column":1},"end":{"line":310,"column":1}},"key":"XgtvROSSPF"},{"type":"thematicBreak","position":{"start":{"line":311,"column":1},"end":{"line":311,"column":1}},"key":"nkqeEWYT0y"},{"type":"heading","depth":2,"position":{"start":{"line":313,"column":1},"end":{"line":313,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":313,"column":1},"end":{"line":313,"column":1}},"children":[{"type":"strong","position":{"start":{"line":313,"column":1},"end":{"line":313,"column":1}},"children":[{"type":"text","value":"Step 4","position":{"start":{"line":313,"column":1},"end":{"line":313,"column":1}},"key":"Ys4tRk1RHC"}],"key":"dQJTJ7MTMT"}],"key":"BEZki7DmW7"}],"identifier":"step-4","label":"Step 4","html_id":"step-4","implicit":true,"key":"R9HtDuT3gC"},{"type":"heading","depth":3,"position":{"start":{"line":315,"column":1},"end":{"line":315,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":315,"column":1},"end":{"line":315,"column":1}},"children":[{"type":"strong","position":{"start":{"line":315,"column":1},"end":{"line":315,"column":1}},"children":[{"type":"text","value":"Net Basis for first, last, and CTD Delivery Date","position":{"start":{"line":315,"column":1},"end":{"line":315,"column":1}},"key":"acWtwqw8V7"}],"key":"aIQBPAVyeP"}],"key":"Lmmexsyzoe"}],"identifier":"net-basis-for-first-last-and-ctd-delivery-date","label":"Net Basis for first, last, and CTD Delivery Date","html_id":"net-basis-for-first-last-and-ctd-delivery-date","implicit":true,"key":"ze22XN5Nvx"},{"type":"code","lang":"py","value":"# 1. Calculate Net Basis for both dates (Forward Price - Invoice Price)\ndf_clean_ctd['Net_Basis_First'] = df_clean_ctd['Forward_First'] - df_clean_ctd['Invoice_First']\ndf_clean_ctd['Net_Basis_Last'] = df_clean_ctd['Forward_Last'] - df_clean_ctd['Invoice_Last']\n\n# 2. THE GRAND FINALE: Find the minimum Net Basis\ndf_clean_ctd['Net_Basis'] = np.minimum(df_clean_ctd['Net_Basis_First'], df_clean_ctd['Net_Basis_Last'])\n\n# 3. Tag the optimal delivery decision so we can see WHICH date won\ndf_clean_ctd['Optimal_Delivery'] = np.where(\n    df_clean_ctd['Net_Basis_First'] <= df_clean_ctd['Net_Basis_Last'],\n    'Immediate (Dec 1)',\n    'Delay (Dec 31)'\n)\n\n# 4. Sort lowest to highest to reveal the true CTD bond!\ndf_clean_ctd = df_clean_ctd.sort_values(by='Net_Basis')\n\n\n# Display the final CTD and show exactly how the minimum was chosen\ndisplay(df_clean_ctd[['Clean Price','Spot_Dirty', 'Optimal_Delivery', 'Net_Basis_First', 'Net_Basis_Last', 'Net_Basis']].head(3))\n","position":{"start":{"line":317,"column":1},"end":{"line":339,"column":1}},"key":"njVA7WI7rE"},{"type":"thematicBreak","position":{"start":{"line":341,"column":1},"end":{"line":341,"column":1}},"key":"lKqUoR3ahy"},{"type":"heading","depth":2,"position":{"start":{"line":343,"column":1},"end":{"line":343,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":343,"column":1},"end":{"line":343,"column":1}},"children":[{"type":"strong","position":{"start":{"line":343,"column":1},"end":{"line":343,"column":1}},"children":[{"type":"text","value":"Step 6","position":{"start":{"line":343,"column":1},"end":{"line":343,"column":1}},"key":"Zw1DpUuLkM"}],"key":"LmBwuvHY0W"}],"key":"Dmv3BZ2w5D"}],"identifier":"step-6","label":"Step 6","html_id":"step-6","implicit":true,"key":"ss688F9HAf"},{"type":"heading","depth":3,"position":{"start":{"line":345,"column":1},"end":{"line":345,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":345,"column":1},"end":{"line":345,"column":1}},"children":[{"type":"strong","position":{"start":{"line":345,"column":1},"end":{"line":345,"column":1}},"children":[{"type":"text","value":"Market Depth","position":{"start":{"line":345,"column":1},"end":{"line":345,"column":1}},"key":"LcGPn15P8O"}],"key":"g3U9c61tcn"}],"key":"GCd3ufk5DG"}],"identifier":"market-depth","label":"Market Depth","html_id":"market-depth","implicit":true,"key":"jpor2Q6xH4"},{"type":"code","lang":"py","value":"# 1. Isolate our CTD candidates (make a clean copy of the top 3)\ndf_top5 = df_clean_ctd.head(3).copy()\n\n# 2. Map out the future cash flows for these specific bonds\ndf_payoff_top5 = fq.create_payoff_df(df_top5, settlement)\n\n# 3. Calculate the time to each cash flow in years (using Actual/365.25 convention)\nmat_years = (pd.to_datetime(df_payoff_top5.columns) - pd.to_datetime(settlement)).days / 365.25\n\n# 4. Calculate Metrics: YTM, Modified Duration, and Convexity\n# We pass an initial YTM guess of 5% (0.05), transpose the cash flows, and pass the spot dirty prices\nytm, duration, convexity = fq.calc_bond_metrics_2d(\n    0.05,\n    df_payoff_top5.T.to_numpy(),\n    mat_years,\n    df_top5['Spot_Dirty'].to_numpy()\n)\n\n# 5. Assign the calculated metrics back to our top 5 DataFrame\ndf_top5[['YTM', 'Duration', 'Convexity']] = pd.DataFrame(\n    {'YTM': ytm, 'Duration': duration, 'Convexity': convexity},\n    index=df_top5.index\n)\n\n# Display the baseline risk metrics rounded to 4 decimal places\ndisplay(df_top5[['YTM', 'Duration', 'Convexity']].round(4))\n","position":{"start":{"line":347,"column":1},"end":{"line":375,"column":1}},"key":"QJbuDYQQwL"}],"key":"na0S2sWJoY"}],"key":"pIhQXgzxzi"}],"key":"Gpe9gIcIhV"}],"key":"SQFKhWXQ4n"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"🔄 Bond and Notes:The Pivot From Cash Settlement to Physical Delivery","short_title":" 🔄 Bond and Notes:The Pivot From Cash Settlement to Physical Delivery","url":"/treasury-futures","group":"Chapter Four: 📊Fixed Income Futures"},"next":{"title":"📝 Chapter Summary","short_title":"📝 Chapter Summary","url":"/chapter-summary","group":"Chapter Four: 📊Fixed Income Futures"}}},"domain":"http://pre.render"}