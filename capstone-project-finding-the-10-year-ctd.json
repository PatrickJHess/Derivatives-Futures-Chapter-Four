":"jpG9xh28Ke"}],"key":"KhDG0vKROF"},{"type":"code","lang":"py","value":"# Use Python's built-in urllib to fetch the remote setup script\nimport urllib.request\n\n# Download, decode, and execute the updater script directly from GitHub\nupdater_url = \"https://raw.githubusercontent.com/PatrickJHess/quant_repo/master/fq_updater.py\"\nexec(urllib.request.urlopen(updater_url).read().decode('utf-8'))\n\n# Run the installer/updater function and alias the package as 'fq'\nfq = import_financial_quant()\n\n# Import libraries and modules\nimport pandas as pd\nimport numpy as np\nfrom datetime import datetime, date\nfrom IPython.display import clear_output\n\n# Instantiate the data pipelines from the financial_quant package\nfred_data = fq.FredReader()\nmassive_data = fq.MASSIVEReader(calls_per_minute=5)","position":{"start":{"line":7,"column":1},"end":{"line":27,"column":1}},"key":"TVzweN1rMZ"},{"type":"thematicBreak","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"Z29A7o3Tdd"},{"type":"heading","depth":2,"position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"strong","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"Step 1","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"zX8M8sNQ8l"}],"key":"FbbVmYKLm8"}],"key":"X5WzVAGAND"}],"identifier":"step-1","label":"Step 1","html_id":"step-1","implicit":true,"key":"vdcjiLoU9G"},{"type":"heading","depth":3,"position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"strong","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"Get Eligible Bonds","position":{"start":{"line":32,"column":1