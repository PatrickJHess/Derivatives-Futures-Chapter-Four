ze 'Maturity' to pure dates\nclean_df_flat['Maturity'] = pd.to_datetime(clean_df_flat['Maturity']).dt.normalize()\ndf_eligible_flat['Maturity'] = pd.to_datetime(df_eligible_flat['Maturity']).dt.normalize()\n\n# 3. Standardize 'Coupon' to floats and round\nclean_df_flat['Coupon'] = clean_df_flat['Coupon'].astype(float).round(4)\ndf_eligible_flat['Coupon'] = df_eligible_flat['Coupon'].astype(float).round(4)\n\n# ---------------------------------------------------------\n# Diagnostic: Find eligible bonds NOT in FedInvest\n# ---------------------------------------------------------\ndf_check = pd.merge(\n    df_eligible_flat,\n    clean_df_flat[['Maturity', 'Coupon']].drop_duplicates(),\n    on=['Maturity', 'Coupon'],\n    how='left',\n    indicator=True\n)\n\nmissing_from_fedinvest = df_check[df_check['_merge'] == 'left_only'].drop(columns=['_merge'])\n\nif not missing_from_fedinvest.empty:\n    print(\"⚠️ WARNING: Eligible bonds missing from FedInvest:\")\n    display(missing_from_fedinvest)\nelse:\n    print(\"✅ All eligible bonds are in FedInvest.\")\n# ---------------------------------------------------------\n\n# 4. Final Inner Merge\ndf_combined = pd.merge(\n    clean_df_flat,\n    df_eligible_flat,\n    on=['Maturity', 'Coupon'],\n    how='inner'\n)\n\n# 5. Set index back and sort\ndf_combined = df_combined.set_index('Maturity').sort_values(by=['Maturity', 'Coupon'])","position":{"start":{"line":74,"column":1},"end":{"line":123,"column":1}},"key":"rFg5JT6gQu"},{"type":"heading","depth":3,"position":{"start":{"line":125,"column":1},"end":{"line":125,"column":1}},"children":[],"key":"nxAMvRvcsb"},{"type":"heading","depth":3,"position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"children":[{"type":"strong","position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"children":[{"type":"text","value":"Clean up the Data","posit