vest(df)\ndisplay(clean_df.head())","position":{"start":{"line":50,"column":1},"end":{"line":63,"column":1}},"key":"zyPb2Oyj2K"},{"type":"heading","depth":3,"position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[],"key":"v8tOxoWss1"},{"type":"heading","depth":3,"position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"strong","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"text","value":"Check for Missing Bonds","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"EIwTdJgIRX"}],"key":"BVVWJolbiV"}],"key":"YSjlFYBfJC"}],"identifier":"check-for-missing-bonds","label":"Check for Missing Bonds","html_id":"check-for-missing-bonds","implicit":true,"key":"bmLhiO6S2X"},{"type":"code","lang":"py","value":"# Elgible are all bonds so drop SECURITY TYPE\nclean_df = clean_df.drop(columns='SECURITY TYPE')\n\n# 1. Standardize names and flatten\nclean_df.index.name = 'Maturity'\nclean_df_flat = clean_df.reset_index()\n\ndf_eligible = df_eligible.rename(columns={'Coupon Rate': 'Coupon'})\ndf_eligible_flat = df_eligible.reset_index()\n\n# 2. Standardize 'Maturity' to pure dates\nclean_df_flat['Maturity'] = pd.to_datetime(clean_df_flat['Maturity']).dt.normalize()\ndf_eligible_flat['Maturity'] = pd.to_datetime(df_eligible_flat['Maturity']).dt.normalize()\n\n# 3. Standardize 'Coupon' to floats and round\nclean_df_flat['Coupon'] = clean_df_flat['Coupon'].astype(float).round(4)\ndf_eligible_flat['Coupon'] = df_eligible_flat['Coupon'].astype(float).round(4)\n\n# ---------------------------------------------------------\n# Diagnostic: Find eligible bonds NOT in FedInvest\n# ---------------------------------------------------------\ndf_check = pd.merge(\n    df_eligible_flat,\n    clean_df_flat[['Maturity', 'Coupon']].drop_duplicates(),\n    on=['Maturity', 'Coupon'],\n    how='left',\n    indicator=True\n)\n\nmissing_from_fedinvest = df_check[df_check['_merge'] == 'left_only'].drop(columns=['_merge'])\n\nif not missing_from_fedinvest.empty:\n    print(\"⚠️ WARNING: Eligible bonds missing from FedInvest:\")\n    display(missing_from_fedinvest)\nelse:\n    print(\"✅ All eligible bonds are in FedInvest.\")\n# ---------------------------------------------------------\n\n# 4. Final Inner Merge\ndf_combined = pd.merge(\n    clean_df_flat,\n    df_eligible_flat,\n    on=['Maturity', 'Coupon'],\n    how='inner'\n)\n\n# 5. Set index back and sort\ndf_combined = df_combined.set_index('Maturity').sort_values(by=['Maturity', 'Coupon'])","position":{"start":{"line":68,"column":1},"end":{"line":117,"column":1}},"key":"Rh3a5AF1F9"},{"type":"heading","depth":3,"position":{"start":{"line":118,"column":1},"end":{"line":118,"column":1}},"children":[],"key":"wJ1lHm2L12"},{"type":"heading","depth":3,"position":{"start":{"line":120,"column":1},"end":{"line":120,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":120,"column":1},"end":{"line":120,"column":1}},"children":[{"type":"strong","position":{"start":{"line":120,"column":1},"end":{"line":120,"column":1}},"children":[{"type":"text","value":"Clean up the Data","position":{"start":{"line":120,"column":1},"end":{"line":120,"column":1}},"key":"K5MX7fgzqt"}],"key":"OMIl9qX70N"}],"key":"qC6W7oaJmk"}],"identifier":"clean-up-the-data","label":"Clean up the Data","html_id":"clean-up-the-data","implicit":true,"key":"stk6N9Nt0B"},{"type":"code","lang":"py","value":"# copy used to make sure the DataFrames aren't linked\nnum_rows = clean_df.shape[0]\ndf_ctd = df_combined[:num_rows].copy()\n\n# vectorized calculation of clean prices\nbid_ask_true = (df_ctd['Price Bid'] > 0) & (df_ctd['Price Ask'] > 0)\n\n# bid/ask average assigned to true_value\ntrue_value = (df_ctd['Price Bid'] + df_ctd['Price Ask']) / 2\n\n# maximum of three prices assigned to false value\nfalse_value = df_ctd[['END OF DAY', 'Price Bid', 'Price Ask']].max(axis=1)\n\n# equivalent to a vectorized if-else assignment of clean price\ndf_ctd['Clean Price'] = np.where(bid_ask_true, true_value, false_value)","position":{"start":{"line":122,"column":1},"end":{"line":138,"column":1}},"key":"BrZg4LUOMJ"},{"type":"thematicBreak","position":{"start":{"line":139,"column":1},"end":{"line":139,"column":1}},"key":"s3Pa1Sngt9"},{"type":"heading","depth":2,"position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"children":[{"type":"strong","position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"children":[{"type":"text","value":"Step 2","position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"key":"IQ5thr2j1C"}],"key":"cdQahTlhqD"}],"key":"Qj8du2YZRs"}],"identifier":"step-2","label":"Step 2","html_id":"step-2","implicit":true,"key":"HKyb4j9uB3"},{"type":"heading","depth":3,"position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"children":[{"type":"strong","position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"children":[{"type":"text","value":"Access SOFR","position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"key":"HdBTbzhLaZ"}],"key":"zuraeFIej6"}],"key":"UYiQfzV4N5"}],"identifier":"access-sofr","label":"Access SOFR","html_id":"access-sofr","implicit":true,"key":"WGZVwrapoc"},{"type":"code","lang":"py","value":"# Use FredReader to the SOFR Rate\nsofr_11_09=fred_data.get_series('SOFR',start_date=settlement,end_date=settlement)\n\n# Get the single value and convert it into floating decimal rate\nsofr=sofr_11_09.values[0]\nsofr_rate=float(sofr[0])\nsofr_rate=sofr_rate/100\n","position":{"start":{"line":145,"column":1},"end":{"line":154,"column":1}},"key":"Asfx5AH0va"},{"type":"heading","depth":3,"position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"children":[{"type":"strong","position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"children":[{"type":"text","value":"`timing_option`","position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"key":"Ef1ytnSXPj"}],"key":"AmaB68g5dj"}],"key":"FMCyoN8aHD"}],"identifier":"id-timing-option","label":"`timing_option`","html_id":"id-timing-option","implicit":true,"key":"xVgoqFo8dp"},{"type":"code","lang":"py","value":"def timing_option(settlement, maturity, coupon, clean_price, sofr_rate, freq=2):\n   \"\"\"\n   Calculates accrued interest, dirty price, daily carry, and the optimal delivery\n   timing (Immediate vs Delay) for a Treasury bond.\n   \"\"\"\n   settlement = pd.Timestamp(settlement)\n   maturity = pd.Timestamp(maturity)\n   current_year = settlement.year\n\n   # --- HELPER FUNCTION ---\n   def get_proxy_maturity(mat, target_year):\n       \"\"\"Creates proxy maturity, utilizing Pandas' native month-end calendar logic.\"\"\"\n       if mat.is_month_end:\n           # Safely grab the exact last day of the target month (handles leap years natively)\n           last_day = pd.Timestamp(year=target_year, month=mat.month, day=1).days_in_month\n           return pd.Timestamp(year=target_year, month=mat.month, day=last_day)\n       else:\n           # Non-EOM dates (like the 15th) are immune to the Feb 29th ValueError\n           return mat.replace(year=target_year)\n   # -----------------------\n\n   # Optimize by creating a proxy maturity date just 1 year out\n   proxy_maturity = get_proxy_maturity(maturity, current_year + 1)\n\n   # 1. Find coupon dates (fq prefix for financial_quant)\n   dates = fq.scheduled_pay_dates(proxy_maturity, settlement=settlement, freq=freq)\n   next_date = pd.Timestamp(dates[0])\n\n   # Dynamically determine months between payments\n   months_between = int(12 / freq)\n\n   # 2. Handle end-of-month Treasury rule for the previous coupon\n   if next_date.is_month_end:\n       last_date = next_date - pd.offsets.MonthEnd(months_between)\n   else:\n       last_date = next_date - pd.DateOffset(months=months_between)\n\n   # 3. Calculate Actual/Actual day counts\n   days_between = (next_date - last_date).days\n   days_since = (settlement - last_date).days\n\n   # 4. Financial Calculations\n   coupon_payment = coupon / freq\n   accrued_interest = coupon_payment * (days_since / days_between)\n   daily_accrual = coupon_payment / days_between\n\n   dirty_price = clean_price + accrued_interest\n   daily_sofr_cost = dirty_price * (sofr_rate / 360)\n\n   return accrued_interest, dirty_price, daily_accrual, daily_sofr_cost, next_date\n","position":{"start":{"line":158,"column":1},"end":{"line":210,"column":1}},"key":"dwRj7Wynns"},{"type":"heading","depth":3,"position":{"start":{"line":212,"column":1},"end":{"line":212,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":212,"column":1},"end":{"line":212,"column":1}},"children":[{"type":"strong","position":{"start":{"line":212,"column":1},"end":{"line":212,"column":1}},"children":[{"type":"text","value":"Calculate Values","position":{"start":{"line":212,"column":1},"end":{"line":212,"column":1}},"key":"vQMyAGb18A"}],"key":"lY62I52hjn"}],"key":"CvbuSEYUe1"}],"identifier":"calculate-values","label":"Calculate Values","html_id":"calculate-values","implicit":true,"key":"DFKqjFnFY2"},{"type":"code","lang":"py","value":"df_ctd[['Accrued_Interest', 'Dirty Price', 'Daily_Accrual', 'Daily_Cost', 'Next_Coupon_Date']] = df_ctd.apply(\n    lambda row: timing_option(settlement,row.name,row['Coupon'],row['Clean Price'],sofr_rate),\n    axis=1,\n    result_type='expand'\n)\ndisplay(df_ctd.head(10))\n","position":{"start":{"line":214,"column":1},"end":{"line":222,"column":1}},"key":"jdL6myccnR"},{"type":"heading","depth":3,"position":{"start":{"line":224,"column":1},"end":{"line":224,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":224,"column":1},"end":{"line":224,"column":1}},"children":[{"type":"strong","position":{"start":{"line":224,"column":1},"end":{"line":224,"column":1}},"children":[{"type":"text","value":"Get Settlement Price","position":{"start":{"line":224,"column":1},"end":{"line":224,"column":1}},"key":"lxG8oJirPc"}],"key":"WTLpjnzPbt"}],"key":"qkyHy2h73Y"}],"identifier":"get-settlement-price","label":"Get Settlement Price","html_id":"get-settlement-price","implicit":true,"key":"w1wxWFxzfO"},{"type":"code","lang":"py","value":"# Use MASSIVEReader\n# Query the December 2026 30-Year T-Bond futures (ZBZ6) on the transaction date\nstart='2026-11-09'\nfutures_11_09=massive_data.get_futures_data('ZBZ6',start_date=start,\n                                           end_date=start)\n\n# Extract the scalar settlement price from the single-row DataFrame\nsettlement_price=futures_11_09['settlement_price'].iloc[0]\nsettlement_price\n","position":{"start":{"line":226,"column":1},"end":{"line":237,"column":1}},"key":"M4wvyHmwB9"},{"type":"heading","depth":3,"position":{"start":{"line":239,"column":1},"end":{"line":239,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":239,"column":1},"end":{"line":239,"column":1}},"children":[{"type":"strong","position":{"start":{"line":239,"column":1},"end":{"line":239,"column":1}},"children":[{"type":"text","value":"Accrued Interest Settlement Date","position":{"start":{"line":239,"column":1},"end":{"line":239,"column":1}},"key":"SvDztMbdPv"}],"key":"oJkRtqN5iN"}],"key":"ffjJjHoGkj"}],"identifier":"accrued-interest-settlement-date","label":"Accrued Interest Settlement Date","html_id":"accrued-interest-settlement-date","implicit":true,"key":"EyiwQt97XS"},{"type":"code","lang":"py","value":"# 1. Define Dates\nt_settlement = pd.Timestamp(settlement)\n\ndays_first = (first_delivery - t_settlement).days\ndays_last = (last_delivery - t_settlement).days\n\n# 2. Check for Interim Coupons and calculate Days Since Coupon\nhas_interim_first = df_ctd['Next_Coupon_Date'] <= first_delivery\nhas_interim_last = df_ctd['Next_Coupon_Date'] <= last_delivery\n\ndays_since_coupon_first = (first_delivery - df_ctd['Next_Coupon_Date']).dt.days\ndays_since_coupon_last = (last_delivery - df_ctd['Next_Coupon_Date']).dt.days\n\n# 3. Calculate Delivery Accrued (Resetting to 0 if an interim coupon was paid)\naccrued_first = np.where(\n    has_interim_first,\n    df_ctd['Daily_Accrual'] * days_since_coupon_first,\n    df_ctd['Accrued_Interest'] + (df_ctd['Daily_Accrual'] * days_first)\n)\n\naccrued_last = np.where(\n    has_interim_last,\n    df_ctd['Daily_Accrual'] * days_since_coupon_last,\n    df_ctd['Accrued_Interest'] + (df_ctd['Daily_Accrual'] * days_last)\n)\n\n# 4. Calculate Invoice Prices\ninvoice_base = settlement_price * df_ctd['Conversion_Factor']\ndf_ctd['Invoice_First'] = invoice_base + accrued_first\ndf_ctd['Invoice_Last'] = invoice_base + accrued_last\n\n# Display the Invoice Price results\n\n#  Drop raw price columns to declutter our working DataFrame\ndf_clean_ctd = df_ctd.drop(columns=['Price Bid', 'Price Ask', 'END OF DAY']).copy()\ndisplay(df_clean_ctd[['Clean Price', 'Next_Coupon_Date', 'Invoice_First', 'Invoice_Last']].head())\n","position":{"start":{"line":241,"column":1},"end":{"line":279,"column":1}},"key":"OhVd3ZQQPy"},{"type":"thematicBreak","position":{"start":{"line":280,"column":1},"end":{"line":280,"column":1}},"key":"yGYiUCLp7u"},{"type":"heading","depth":2,"position":{"start":{"line":282,"column":1},"end":{"line":282,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":282,"column":1},"end":{"line":282,"column":1}},"children":[{"type":"strong","position":{"start":{"line":282,"column":1},"end":{"line":282,"column":1}},"children":[{"type":"text","value":"Step 3","position":{"start":{"line":282,"column":1},"end":{"line":282,"column":1}},"key":"P60z5OOen4"}],"key":"GtXz0iXiUn"}],"key":"TJsmd64oTs"}],"identifier":"step-3","label":"Step 3","html_id":"step-3","implicit":true,"key":"AEtPXYV6GC"},{"type":"heading","depth":3,"position":{"start":{"line":284,"column":1},"end":{"line":284,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":284,"column":1},"end":{"line":284,"column":1}},"children":[{"type":"strong","position":{"start":{"line":284,"column":1},"end":{"line":284,"column":1}},"children":[{"type":"text","value":"Forward Cash Prices","position":{"start":{"line":284,"column":1},"end":{"line":284,"column":1}},"key":"w0Bt9l5M4r"}],"key":"FT9IhLAbGO"}],"key":"bKtO8LNEak"}],"identifier":"forward-cash-prices","label":"Forward Cash Prices","html_id":"forward-cash-prices","implicit":true,"key":"VaFgFVt6Ci"},{"type":"code","lang":"py","value":"# 1. Calculate Spot Dirty Price (Clean Price + Spot Accrued Interest)\ndf_clean_ctd['Spot_Dirty'] = df_clean_ctd['Clean Price'] + df_clean_ctd['Accrued_Interest']\n\n# 2. Define the cash coupon payment (Semi-annual)\ncoupon_pmt = df_clean_ctd['Coupon'] / 2\n\n# 3. Calculate Forward Cash Prices\n# If an interim coupon is paid, we subtract the cash received from our total forward cost\ndf_clean_ctd['Forward_First'] = np.where(\n    has_interim_first,\n    df_clean_ctd['Spot_Dirty'] + (df_clean_ctd['Daily_Cost'] * days_first) - coupon_pmt,\n    df_clean_ctd['Spot_Dirty'] + (df_clean_ctd['Daily_Cost'] * days_first)\n)\n\ndf_clean_ctd['Forward_Last'] = np.where(\n    has_interim_last,\n    df_clean_ctd['Spot_Dirty'] + (df_clean_ctd['Daily_Cost'] * days_last) - coupon_pmt,\n    df_clean_ctd['Spot_Dirty'] + (df_clean_ctd['Daily_Cost'] * days_last)\n)\n\n# Display the Forward Prices\ndisplay(df_clean_ctd[['Clean Price', 'Spot_Dirty','Daily_Cost', 'Forward_First', 'Forward_Last']].head())\n","position":{"start":{"line":286,"column":1},"end":{"line":310,"column":1}},"key":"Za4VW8qjdE"},{"type":"thematicBreak","position":{"start":{"line":311,"column":1},"end":{"line":311,"column":1}},"key":"QTKFdgPVJl"},{"type":"heading","depth":2,"position":{"start":{"line":313,"column":1},"end":{"line":313,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":313,"column":1},"end":{"line":313,"column":1}},"children":[{"type":"strong","position":{"start":{"line":313,"column":1},"end":{"line":313,"column":1}},"children":[{"type":"text","value":"Step 4","position":{"start":{"line":313,"column":1},"end":{"line":313,"column":1}},"key":"B81ADbNNJ7"}],"key":"lT2uGKoz8C"}],"key":"gw4XMX2wL7"}],"identifier":"step-4","label":"Step 4","html_id":"step-4","implicit":true,"key":"sTBKSmaGEC"},{"type":"heading","depth":3,"position":{"start":{"line":315,"column":1},"end":{"line":315,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":315,"column":1},"end":{"line":315,"column":1}},"children":[{"type":"strong","position":{"start":{"line":315,"column":1},"end":{"line":315,"column":1}},"children":[{"type":"text","value":"Net Basis for first, last, and CTD Delivery Date","position":{"start":{"line":315,"column":1},"end":{"line":315,"column":1}},"key":"TeoX6l0AbE"}],"key":"Ic1PEfD5XF"}],"key":"j1k5MLCpNx"}],"identifier":"net-basis-for-first-last-and-ctd-delivery-date","label":"Net Basis for first, last, and CTD Delivery Date","html_id":"net-basis-for-first-last-and-ctd-delivery-date","implicit":true,"key":"US3zMGXl5v"},{"type":"code","lang":"py","value":"# 1. Calculate Net Basis for both dates (Forward Price - Invoice Price)\ndf_clean_ctd['Net_Basis_First'] = df_clean_ctd['Forward_First'] - df_clean_ctd['Invoice_First']\ndf_clean_ctd['Net_Basis_Last'] = df_clean_ctd['Forward_Last'] - df_clean_ctd['Invoice_Last']\n\n# 2. THE GRAND FINALE: Find the minimum Net Basis\ndf_clean_ctd['Net_Basis'] = np.minimum(df_clean_ctd['Net_Basis_First'], df_clean_ctd['Net_Basis_Last'])\n\n# 3. Tag the optimal delivery decision so we can see WHICH date won\ndf_clean_ctd['Optimal_Delivery'] = np.where(\n    df_clean_ctd['Net_Basis_First'] <= df_clean_ctd['Net_Basis_Last'],\n    'Immediate (Dec 1)',\n    'Delay (Dec 31)'\n)\n\n# 4. Sort lowest to highest to reveal the true CTD bond!\ndf_clean_ctd = df_clean_ctd.sort_values(by='Net_Basis')\n\n\n# Display the final CTD and show exactly how the minimum was chosen\ndisplay(df_clean_ctd[['Clean Price','Spot_Dirty', 'Optimal_Delivery', 'Net_Basis_First', 'Net_Basis_Last', 'Net_Basis']].head(3))\n","position":{"start":{"line":317,"column":1},"end":{"line":339,"column":1}},"key":"yY0t8fHKHA"},{"type":"thematicBreak","position":{"start":{"line":340,"column":1},"end":{"line":340,"column":1}},"key":"vUPcZEEBHr"},{"type":"heading","depth":2,"position":{"start":{"line":342,"column":1},"end":{"line":342,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":342,"column":1},"end":{"line":342,"column":1}},"children":[{"type":"strong","position":{"start":{"line":342,"column":1},"end":{"line":342,"column":1}},"children":[{"type":"text","value":"Step 6","position":{"start":{"line":342,"column":1},"end":{"line":342,"column":1}},"key":"YZMYX6l27h"}],"key":"S0dSMcmk6Y"}],"key":"F95xs92UNC"}],"identifier":"step-6","label":"Step 6","html_id":"step-6","implicit":true,"key":"KpaSo2rc7O"},{"type":"heading","depth":3,"position":{"start":{"line":344,"column":1},"end":{"line":344,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":344,"column":1},"end":{"line":344,"column":1}},"children":[{"type":"strong","position":{"start":{"line":344,"column":1},"end":{"line":344,"column":1}},"children":[{"type":"text","value":"Market Depth","position":{"start":{"line":344,"column":1},"end":{"line":344,"column":1}},"key":"aYhHo4XZji"}],"key":"QKqjs9DWDz"}],"key":"QKF4YIGrGZ"}],"identifier":"market-depth","label":"Market Depth","html_id":"market-depth","implicit":true,"key":"hTxmfxJpe7"},{"type":"code","lang":"py","value":"# 1. Isolate our CTD candidates (make a clean copy of the top 3)\ndf_top5 = df_clean_ctd.head(3).copy()\n\n# 2. Map out the future cash flows for these specific bonds\ndf_payoff_top5 = fq.create_payoff_df(df_top5, settlement)\n\n# 3. Calculate the time to each cash flow in years (using Actual/365.25 convention)\nmat_years = (pd.to_datetime(df_payoff_top5.columns) - pd.to_datetime(settlement)).days / 365.25\n\n# 4. Calculate Metrics: YTM, Modified Duration, and Convexity\n# We pass an initial YTM guess of 5% (0.05), transpose the cash flows, and pass the spot dirty prices\nytm, duration, convexity = fq.calc_bond_metrics_2d(\n    0.05,\n    df_payoff_top5.T.to_numpy(),\n    mat_years,\n    df_top5['Spot_Dirty'].to_numpy()\n)\n\n# 5. Assign the calculated metrics back to our top 5 DataFrame\ndf_top5[['YTM', 'Duration', 'Convexity']] = pd.DataFrame(\n    {'YTM': ytm, 'Duration': duration, 'Convexity': convexity},\n    index=df_top5.index\n)\n\n# Display the baseline risk metrics rounded to 4 decimal places\ndisplay(df_top5[['YTM', 'Duration', 'Convexity']].round(4))\n","position":{"start":{"line":346,"column":1},"end":{"line":374,"column":1}},"key":"gABKo9hrVm"}],"key":"tP1OLWytAb"}],"key":"vj8h6zHSZj"}],"key":"aRcfGh032V"}],"key":"IjtqYEykm6"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"🔄 Bond and Notes:The Pivot From Cash Settlement to Physical Delivery","short_title":" 🔄 Bond and Notes:The Pivot From Cash Settlement to Physical Delivery","url":"/treasury-futures","group":"Chapter Four: 📊Fixed Income Futures"},"next":{"title":"📝 Chapter Summary","short_title":"📝 Chapter Summary","url":"/chapter-summary","group":"Chapter Four: 📊Fixed Income Futures"}}},"domain":"http://pre.render"}