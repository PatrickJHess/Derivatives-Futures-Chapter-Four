ine":155,"column":1},"end":{"line":155,"column":1}},"children":[{"type":"text","value":"Step 2","position":{"start":{"line":155,"column":1},"end":{"line":155,"column":1}},"key":"Z72iZfT0P8"}],"key":"WOzB2b7f5N"}],"key":"n1dAkxhNef"}],"identifier":"step-2","label":"Step 2","html_id":"step-2","implicit":true,"key":"mu1kwB1pa4"},{"type":"heading","depth":3,"position":{"start":{"line":157,"column":1},"end":{"line":157,"column":1}},"children":[],"key":"fgOFPFdSuN"},{"type":"heading","depth":3,"position":{"start":{"line":159,"column":1},"end":{"line":159,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":159,"column":1},"end":{"line":159,"column":1}},"children":[{"type":"strong","position":{"start":{"line":159,"column":1},"end":{"line":159,"column":1}},"children":[{"type":"text","value":"Access SOFR","position":{"start":{"line":159,"column":1},"end":{"line":159,"column":1}},"key":"i9aGFnvr3f"}],"key":"SBCjQZccX4"}],"key":"cZxkVd2FlW"}],"identifier":"access-sofr","label":"Access SOFR","html_id":"access-sofr","implicit":true,"key":"TDyZRP4blk"},{"type":"code","lang":"py","value":"# Use FredReader to the SOFR Rate\nsofr_11_09=fred_data.get_series('SOFR',start_date=settlement,end_date=settlement)\n\n# Get the single value and convert it into floating decimal rate\nsofr=sofr_11_09.values[0]\nsofr_rate=float(sofr[0])\nsofr_rate=sofr_rate/100\n","position":{"start":{"line":161,"column":1},"end":{"line":170,"column":1}},"key":"tqqdYyvBJ7"},{"type":"heading","depth":3,"position":{"start":{"line":172,"column":1},"end":{"line":172,"column":1}},"children":[],"key":"jIxjhnVQEv"},{"type":"heading","depth":3,"position":{"start":{"line":174,"column":1},"end":{"line":174,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":174,"column":1},"end":{"line":174,"column":1}},"children":[{"type":"strong","position":{"start":{"line":174,"column":1},"end":{"line":174,"column":1}},"children":[{"type":"text","value":"`timing_option`","position":{"start":{"line":174,"column":1},"end":{"line":174,"column":1}},"key":"Hqk4XPSK4H"}],"key":"XNmEH5zUf0"}],"key":"VMGLb9MquP"}],"identifier":"id-timing-option","label":"`timing_option`","html_id":"id-timing-option","implicit":true,"key":"LnpkptX7BW"},{"type":"code","lang":"py","value":"def timing_option(settlement, maturity, coupon, clean_price, sofr_rate, freq=2):\n   \"\"\"\n   Calculates accrued interest, dirty price, daily carry, and the optimal delivery\n   timing (Immediate vs Delay) for a Treasury bond.\n   \"\"\"\n   settlement = pd.Timestamp(settlement)\n   maturity = pd.Timestamp(maturity)\n   current_year = settlement.year\n\n   # --- HELPER FUNCTION ---\n   def get_proxy_maturity(mat, target_year):\n       \"\"\"Creates proxy maturity, utilizing Pandas' native month-end calendar logic.\"\"\"\n       if mat.is_month_end:\n           # Safely grab the exact last day of the target month (handles leap years natively)\n           last_day = pd.Timestamp(year=target_year, month=mat.month, day=1).days_in_month\n           return pd.Timestamp(year=target_year, month=mat.month, day=last_day)\n       else:\n           # Non-EOM dates (like the 15th) are immune to the Feb 29th ValueError\n           return mat.replace(year=target_year)\n   # -----------------------\n\n   # Optimize by creating a proxy maturity date just 1 year out\n   proxy_maturity = get_proxy_maturity(maturity, current_year + 1)\n\n   # 1. Find coupon dates (fq prefix for financial_quant)\n   dates = fq.scheduled_pay_dates(proxy_maturity, settlement=settlement, freq=freq)\n   next_date = pd.Timestamp(dates[0])\n\n   # Dynamically determine months between payments\n   months_between = int(12 / freq)\n\n   # 2. Handle end-of-month Treasury rule for the previous coupon\n   if next_date.is_month_end:\n       last_date = next_date - pd.offsets.MonthEnd(months_between)\n   else:\n       last_date = next_date - pd.DateOffset(months=months_between)\n\n   # 3. Calculate Actual/Actual day counts\n   days_between = (next_date - last_date).days\n   days_since = (settlement - last_date).days\n\n   # 4. Financial Calculations\n   coupon_payment = coupon / freq\n   accrued_interest = coupon_payment * (days_since / days_between)\n   daily_accrual = coupon_payment / days_between\n\n   dirty_price = clean_price + accrued_interest\n   daily_sofr_cost = dirty_price * (sofr_rate / 360)\n\n   return accrued_interest, dirty_price, daily_accrual, daily_sofr_cost, next_date\n","position":{"start":{"line":176,"column":1},"end":{"line":228,"column":1}},"key":"C0Dt5NFNj0"},{"type":"heading","depth":3,"position":{"start":{"line":230,"column":1},"end":{"line":230,"column":1}},"children":[],"key":"KUYHZyKH0w"},{"type":"heading","depth":3,"position":{"start":{"line":232,"column":1},"end":{"line":232,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":232,"column":1},"end":{"line":232,"column":1}},"children":[{"type":"strong","position":{"start":{"line":232,"column":1},"end":{"line":232,"column":1}},"children":[{"type":"text","value":"Calculate Values","position":{"start":{"line":232,"column":1},"end":{"line":232,"column":1}},"key":"Elc7USaawA"}],"key":"yRV6NHvfYH"}],"key":"o65PYKXv5Q"}],"identifier":"calculate-values","label":"Calculate Values","html_id":"calculate-values","implicit":true,"key":"hfYdEHu8Dx"},{"type":"code","lang":"py","value":"df_ctd[['Accrued_Interest', 'Dirty Price', 'Daily_Accrual', 'Daily_Cost', 'Next_Coupon_Date']] = df_ctd.apply(\n    lambda row: timing_option(settlement,row.name,row['Coupon'],row['Clean Price'],sofr_rate),\n    axis=1,\n    result_type='expand'\n)\ndisplay(df_ctd.head(10))\n","position":{"start":{"line":234,"column":1},"end":{"line":242,"column":1}},"key":"MT5INC9RqJ"},{"type":"heading","depth":3,"position":{"start":{"line":244,"column":1},"end":{"line":244,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":244,"column":1},"end":{"line":244,"column":1}},"children":[{"type":"strong","position":{"start":{"line":244,"column":1},"end":{"line":244,"column":1}},"children":[{"type":"text","value":"Get Settlement Price","position":{"start":{"line":244,"column":1},"end":{"line":244,"column":1}},"key":"G0VftxDTDF"}],"key":"TbJ5W913Qw"}],"key":"ifAFi6GqI3"}],"identifier":"get-settlement-price","label":"Get Settlement Price","html_id":"get-settlement-price","implicit":true,"key":"s2XrB0udMI"},{"type":"code","lang":"py","value":"# Use MASSIVEReader\n# Query the December 2026 30-Year T-Bond futures (ZBZ6) on the transaction date\nstart='2026-11-09'\nfutures_11_09=massive_data.get_futures_data('ZBZ6',start_date=start,\n                                           end_date=start)\n\n# Extract the scalar settlement price from the single-row DataFrame\nsettlement_price=futures_11_09['settlement_price'].iloc[0]\nsettlement_price\n","position":{"start":{"line":246,"column":1},"end":{"line":257,"column":1}},"key":"dy9gcoabOm"},{"type":"heading","depth":3,"position":{"start":{"line":259,"column":1},"end":{"line":259,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":259,"column":1},"end":{"line":259,"column":1}},"children":[{"type":"strong","position":{"start":{"line":259,"column":1},"end":{"line":259,"column":1}},"children":[{"type":"text","value":"Accrued Interest Settlement Date","position":{"start":{"line":259,"column":1},"end":{"line":259,"column":1}},"key":"pq3TxjCI9G"}],"key":"GNVmZtdCCg"}],"key":"Zeg3uzEXrj"}],"identifier":"accrued-interest-settlement-date","label":"Accrued Interest Settlement Date","html_id":"accrued-interest-settlement-date","implicit":true,"key":"cdxcxq8A0c"},{"type":"code","lang":"py","value":"# 1. Define Dates\nt_settlement = pd.Timestamp(settlement)\n\ndays_first = (first_delivery - t_settlement).days\ndays_last = (last_delivery - t_settlement).days\n\n# 2. Check for Interim Coupons and calculate Days Since Coupon\nhas_interim_first = df_ctd['Next_Coupon_Date'] <= first_delivery\nhas_interim_last = df_ctd['Next_Coupon_Date'] <= last_delivery\n\ndays_since_coupon_first = (first_delivery - df_ctd['Next_Coupon_Date']).dt.days\ndays_since_coupon_last = (last_delivery - df_ctd['Next_Coupon_Date']).dt.days\n\n# 3. Calculate Delivery Accrued (Resetting to 0 if an interim coupon was paid)\naccrued_first = np.where(\n    has_interim_first,\n    df_ctd['Daily_Accrual'] * days_since_coupon_first,\n    df_ctd['Accrued_Interest'] + (df_ctd['Daily_Accrual'] * days_first)\n)\n\naccrued_last = np.where(\n    has_interim_last,\n    df_ctd['Daily_Accrual'] * days_since_coupon_last,\n    df_ctd['Accrued_Interest'] + (df_ctd['Daily_Accrual'] * days_last)\n)\n\n# 4. Calculate Invoice Prices\ninvoice_base = settlement_price * df_ctd['Conversion_Factor']\ndf_ctd['Invoice_First'] = invoice_base + accrued_first\ndf_ctd['Invoice_Last'] = invoice_base + accrued_last\n\n# Display the Invoice Price results\n\n#  Drop raw price columns to declutter our working DataFrame\ndf_clean_ctd = df_ctd.drop(columns=['Price Bid', 'Price Ask', 'END OF DAY']).copy()\ndisplay(df_clean_ctd[['Clean Price', 'Next_Coupon_Date', 'Invoice_First', 'Invoice_Last']].head())\n","position":{"start":{"line":261,"column":1},"end":{"line":299,"column":1}},"key":"cwKcqEL6hj"},{"type":"thematicBreak","position":{"start":{"line":301,"column":1},"end":{"line":301,"column":1}},"key":"cth1G1gx5e"},{"type":"heading","depth":2,"position":{"start":{"line":303,"column":1},"end":{"line":303,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":303,"column":1},"end":{"line":303,"column":1}},"children":[{"type":"strong","position":{"start":{"line":303,"column":1},"end":{"line":303,"column":1}},"children":[{"type":"text","value":"Step 3","position":{"start":{"line":303,"column":1},"end":{"line":303,"column":1}},"key":"gEEcX7Fg9S"}],"key":"Fq7m6UJu1K"}],"key":"R4etoM718C"}],"identifier":"step-3","label":"Step 3","html_id":"step-3","implicit":true,"key":"cdsAQ2Jc5a"},{"type":"heading","depth":3,"position":{"start":{"line":305,"column":1},"end":{"line":305,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":305,"column":1},"end":{"line":305,"column":1}},"children":[{"type":"strong","position":{"start":{"line":305,"column":1},"end":{"line":305,"column":1}},"children":[{"type":"text","value":"Forward Cash Prices","position":{"start":{"line":305,"column":1},"end":{"line":305,"column":1}},"key":"dPiUSJosC1"}],"key":"FW1ljnqhUo"}],"key":"xk3ritDOTj"}],"identifier":"forward-cash-prices","label":"Forward Cash Prices","html_id":"forward-cash-prices","implicit":true,"key":"R4lo862T5s"},{"type":"code","lang":"py","value":"# 1. Calculate Spot Dirty Price (Clean Price + Spot Accrued Interest)\ndf_clean_ctd['Spot_Dirty'] = df_clean_ctd['Clean Price'] + df_clean_ctd['Accrued_Interest']\n\n# 2. Define the cash coupon payment (Semi-annual)\ncoupon_pmt = df_clean_ctd['Coupon'] / 2\n\n# 3. Calculate Forward Cash Prices\n# If an interim coupon is paid, we subtract the cash received from our total forward cost\ndf_clean_ctd['Forward_First'] = np.where(\n    has_interim_first,\n    df_clean_ctd['Spot_Dirty'] + (df_clean_ctd['Daily_Cost'] * days_first) - coupon_pmt,\n    df_clean_ctd['Spot_Dirty'] + (df_clean_ctd['Daily_Cost'] * days_first)\n)\n\ndf_clean_ctd['Forward_Last'] = np.where(\n    has_interim_last,\n    df_clean_ctd['Spot_Dirty'] + (df_clean_ctd['Daily_Cost'] * days_last) - coupon_pmt,\n    df_clean_ctd['Spot_Dirty'] + (df_clean_ctd['Daily_Cost'] * days_last)\n)\n\n# Display the Forward Prices\ndisplay(df_clean_ctd[['Clean Price', 'Spot_Dirty','Daily_Cost', 'Forward_First', 'Forward_Last']].head())\n","position":{"start":{"line":307,"column":1},"end":{"line":331,"column":1}},"key":"GkacuQcH1B"},{"type":"thematicBreak","position":{"start":{"line":333,"column":1},"end":{"line":333,"column":1}},"key":"DuP5e22c6X"},{"type":"heading","depth":2,"position":{"start":{"line":335,"column":1},"end":{"line":335,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":335,"column":1},"end":{"line":335,"column":1}},"children":[{"type":"strong","position":{"start":{"line":335,"column":1},"end":{"line":335,"column":1}},"children":[{"type":"text","value":"Step 4","position":{"start":{"line":335,"column":1},"end":{"line":335,"column":1}},"key":"RwzYVfeDLL"}],"key":"uPsZ2XjA0u"}],"key":"FX2wy0Aeht"}],"identifier":"step-4","label":"Step 4","html_id":"step-4","implicit":true,"key":"wIUfCsGbjv"},{"type":"heading","depth":3,"position":{"start":{"line":337,"column":1},"end":{"line":337,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":337,"column":1},"end":{"line":337,"column":1}},"children":[{"type":"strong","position":{"start":{"line":337,"column":1},"end":{"line":337,"column":1}},"children":[{"type":"text","value":"Net Basis for first, last, and CTD Delivery Date","position":{"start":{"line":337,"column":1},"end":{"line":337,"column":1}},"key":"kzQL0PdOxN"}],"key":"qJKKRqYorh"}],"key":"kBGUKaLBdn"}],"identifier":"net-basis-for-first-last-and-ctd-delivery-date","label":"Net Basis for first, last, and CTD Delivery Date","html_id":"net-basis-for-first-last-and-ctd-delivery-date","implicit":true,"key":"UlQDgXE0Eu"},{"type":"code","lang":"py","value":"# 1. Calculate Net Basis for both dates (Forward Price - Invoice Price)\ndf_clean_ctd['Net_Basis_First'] = df_clean_ctd['Forward_First'] - df_clean_ctd['Invoice_First']\ndf_clean_ctd['Net_Basis_Last'] = df_clean_ctd['Forward_Last'] - df_clean_ctd['Invoice_Last']\n\n# 2. THE GRAND FINALE: Find the minimum Net Basis\ndf_clean_ctd['Net_Basis'] = np.minimum(df_clean_ctd['Net_Basis_First'], df_clean_ctd['Net_Basis_Last'])\n\n# 3. Tag the optimal delivery decision so we can see WHICH date won\ndf_clean_ctd['Optimal_Delivery'] = np.where(\n    df_clean_ctd['Net_Basis_First'] <= df_clean_ctd['Net_Basis_Last'],\n    'Immediate (Dec 1)',\n    'Delay (Dec 31)'\n)\n\n# 4. Sort lowest to highest to reveal the true CTD bond!\ndf_clean_ctd = df_clean_ctd.sort_values(by='Net_Basis')\n\n\n# Display the final CTD and show exactly how the minimum was chosen\ndisplay(df_clean_ctd[['Clean Price','Spot_Dirty', 'Optimal_Delivery', 'Net_Basis_First', 'Net_Basis_Last', 'Net_Basis']].head(3))\n","position":{"start":{"line":339,"column":1},"end":{"line":361,"column":1}},"key":"bFeZlXUsUJ"},{"type":"thematicBreak","position":{"start":{"line":363,"column":1},"end":{"line":363,"column":1}},"key":"gV0yEYzW0e"},{"type":"heading","depth":2,"position":{"start":{"line":365,"column":1},"end":{"line":365,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":365,"column":1},"end":{"line":365,"column":1}},"children":[{"type":"strong","position":{"start":{"line":365,"column":1},"end":{"line":365,"column":1}},"children":[{"type":"text","value":"Step 6","position":{"start":{"line":365,"column":1},"end":{"line":365,"column":1}},"key":"srrBzoDljK"}],"key":"T8SmPCFRvB"}],"key":"fWmRvjjXSA"}],"identifier":"step-6","label":"Step 6","html_id":"step-6","implicit":true,"key":"MKgUOrcNZh"},{"type":"heading","depth":3,"position":{"start":{"line":367,"column":1},"end":{"line":367,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":367,"column":1},"end":{"line":367,"column":1}},"children":[{"type":"strong","position":{"start":{"line":367,"column":1},"end":{"line":367,"column":1}},"children":[{"type":"text","value":"Market Depth","position":{"start":{"line":367,"column":1},"end":{"line":367,"column":1}},"key":"mnAjwukQzS"}],"key":"RvUEpZRarU"}],"key":"hU32JVVFAl"}],"identifier":"market-depth","label":"Market Depth","html_id":"market-depth","implicit":true,"key":"x7A2TccJai"},{"type":"code","lang":"py","value":"# 1. Isolate our CTD candidates (make a clean copy of the top 3)\ndf_top5 = df_clean_ctd.head(3).copy()\n\n# 2. Map out the future cash flows for these specific bonds\ndf_payoff_top5 = fq.create_payoff_df(df_top5, settlement)\n\n# 3. Calculate the time to each cash flow in years (using Actual/365.25 convention)\nmat_years = (pd.to_datetime(df_payoff_top5.columns) - pd.to_datetime(settlement)).days / 365.25\n\n# 4. Calculate Metrics: YTM, Modified Duration, and Convexity\n# We pass an initial YTM guess of 5% (0.05), transpose the cash flows, and pass the spot dirty prices\nytm, duration, convexity = fq.calc_bond_metrics_2d(\n    0.05,\n    df_payoff_top5.T.to_numpy(),\n    mat_years,\n    df_top5['Spot_Dirty'].to_numpy()\n)\n\n# 5. Assign the calculated metrics back to our top 5 DataFrame\ndf_top5[['YTM', 'Duration', 'Convexity']] = pd.DataFrame(\n    {'YTM': ytm, 'Duration': duration, 'Convexity': convexity},\n    index=df_top5.index\n)\n\n# Display the baseline risk metrics rounded to 4 decimal places\ndisplay(df_top5[['YTM', 'Duration', 'Convexity']].round(4))\n","position":{"start":{"line":369,"column":1},"end":{"line":397,"column":1}},"key":"ls6dfzjS4E"}],"key":"WlUhVm0yGh"}],"key":"UR6414M79U"}],"key":"Q6mNPqzNv6"}],"key":"g313Pzui7P"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"next":{"title":"Setup The Notebook","url":"/chapter-four","group":"📊 Fixed Income Futures"}}},"domain":"http://pre.render"}